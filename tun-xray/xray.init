#!/bin/sh /etc/rc.common

USE_PROCD=1
# after network
START=50

BASE_DIR=/opt/tun-xray
PROG=$BASE_DIR/xray
NAME=xray

PIDFILE=/var/run/$NAME.pid

start_service() {
	procd_open_instance
	procd_set_param command $PROG run -config $BASE_DIR/xray_config.json
	procd_set_param pidfile $PIDFILE
	procd_close_instance
}